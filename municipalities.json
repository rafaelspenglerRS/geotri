/* ========================================
   GEO TRI - GRID CSS
   Paleta: Invest RS
   ======================================== */

:root {
    --color-primary: #1B8A3E;
    --color-primary-dark: #156B31;
    --color-accent-yellow: #FFC107;
    --color-white: #FFFFFF;
    --color-dark: #333333;
    --color-border: #DDDDDD;
}

/* ===== CLUES TOP ===== */
.clues-top {
    display: grid;
    grid-template-columns: 120px repeat(3, 1fr);
    gap: 2px;
    margin-bottom: 0;
    background-color: var(--color-border);
    padding: 2px;
    border-radius: 8px;
}

.clue-spacer {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    border-radius: 8px;
}

/* ===== GRID WRAPPER ===== */
.grid-wrapper {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 0;
}

/* ===== CLUES LEFT ===== */
.clues-left {
    display: flex;
    flex-direction: column;
    gap: 2px;
    background-color: var(--color-border);
    padding: 2px;
    border-radius: 8px;
}

.clues-left .clue {
    height: auto;
    min-height: 100px;
}

/* ===== CLUES STYLING ===== */
.clue {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: var(--color-white);
    padding: 16px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    word-wrap: break-word;
    overflow-wrap: break-word;
    word-break: break-word;
}

.clue.horizontal {
    background: linear-gradient(135deg, var(--color-accent-yellow) 0%, #FFB300 100%);
    color: var(--color-dark);
}

/* ===== GRID 3x3 ===== */
.grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, 1fr);
    gap: 2px;
    background-color: var(--color-border);
    padding: 2px;
    border-radius: 8px;
    aspect-ratio: 1;
    width: 100%;
    max-width: 600px;
}

/* ===== CÉLULAS ===== */
.cell {
    background: var(--color-white);
    border: 2px solid var(--color-border);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
    min-height: 100px;
    gap: 8px;
}

.cell:hover:not(.filled) {
    border-color: var(--color-primary);
    background: #F9F9F9;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(27, 138, 62, 0.2);
}

.cell.filled {
    background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
    border-color: var(--color-primary);
    cursor: default;
}

.cell.filled:hover {
    transform: none;
}

.cell.error {
    background: linear-gradient(135deg, #FFEBEE 0%, #FFCDD2 100%);
    border-color: #C62828;
    animation: shake 0.4s ease-in-out;
}

/* ===== CONTEÚDO DA CÉLULA ===== */
.cell-flag {
    font-size: 32px;
    line-height: 1;
}

.cell-name {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-dark);
    text-align: center;
    word-wrap: break-word;
    max-width: 100%;
}

.cell-empty {
    color: #95a5a6;
    font-size: 24px;
}

/* ===== ANIMAÇÕES DE CÉLULA ===== */
.cell.correct-animation {
    animation: correctAnswer 0.6s ease;
}

.cell.shake-animation {
    animation: shake 0.4s ease;
}

@keyframes correctAnswer {
    0% {
        transform: scale(1);
        background: var(--color-white);
    }
    50% {
        transform: scale(1.05);
    }
    100% {
        transform: scale(1);
        background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
    }
}

@keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-5px); }
    75% { transform: translateX(5px); }
}

/* ===== RESPONSIVIDADE ===== */
@media (max-width: 768px) {
    .clues-top {
        grid-template-columns: 100px repeat(3, 1fr);
        gap: 1px;
        padding: 1px;
    }

    .grid-wrapper {
        gap: 0;
    }

    .clues-left {
        gap: 1px;
        padding: 1px;
    }

    .clues-left .clue {
        min-height: 80px;
    }

    .clue {
        padding: 12px;
        font-size: 11px;
    }

    .grid {
        gap: 1px;
        padding: 1px;
    }

    .cell {
        min-height: 80px;
        gap: 4px;
    }

    .cell-flag {
        font-size: 24px;
    }

    .cell-name {
        font-size: 10px;
    }
}

@media (max-width: 480px) {
    .clues-top {
        grid-template-columns: 80px repeat(3, 1fr);
        gap: 1px;
        padding: 1px;
    }

    .grid-wrapper {
        gap: 0;
    }

    .clues-left {
        gap: 1px;
        padding: 1px;
    }

    .clues-left .clue {
        min-height: 60px;
    }

    .clue {
        padding: 8px;
        font-size: 10px;
    }

    .grid {
        gap: 1px;
        padding: 1px;
    }

    .cell {
        min-height: 60px;
        gap: 3px;
    }

    .cell-flag {
        font-size: 18px;
    }

    .cell-name {
        font-size: 9px;
    }
}
